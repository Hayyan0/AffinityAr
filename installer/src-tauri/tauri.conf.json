{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AffinityArabicInstaller",
  "version": "1.0.0",
  "identifier": "com.affinity.arabic.installer",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Affinity Arabic Installer",
        "width": 980,
        "height": 650,
        "resizable": false,
        "fullscreen": false,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "copyright": "Copyright (C) 2026 Hayyan (@HayyanCodes). All rights reserved.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
