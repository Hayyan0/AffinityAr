#include <windows.h>

#define VER_FILEVERSION             2,0,0,0
#define VER_FILEVERSION_STR         "2.0.0.0\0"
#define VER_PRODUCTVERSION          2,0,0,0
#define VER_PRODUCTVERSION_STR       "2.0.0.0\0"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VER_FILEVERSION
PRODUCTVERSION  VER_PRODUCTVERSION
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Hayyan (@HayyanCodes)\0"
            VALUE "FileDescription",  "Affinity Arabic Native Support by Hayyan (@HayyanCodes)\0"
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     "AffinityArabic\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Hayyan (@HayyanCodes). All rights reserved.\0"
            VALUE "OriginalFilename", "affinity_arabic.dll\0"
            VALUE "ProductName",      "Affinity Arabic Native Support\0"
            VALUE "ProductVersion",   VER_PRODUCTVERSION_STR
            VALUE "Comments",         "Twitter / X: https://x.com/HayyanCodes\0"
            VALUE "LegalTrademarks",  "https://x.com/HayyanCodes\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
